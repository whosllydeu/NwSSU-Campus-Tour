# Project settings — from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — NOT the anon key. Bypasses RLS, so this must
# never be committed, shared, or used in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — lets `npm run create-admin` run with no arguments.

